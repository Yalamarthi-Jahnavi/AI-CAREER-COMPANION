# AI Career Companion Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file to version control.

# Application Ports & API
PORT=5000
VITE_API_URL=http://localhost:5000/api/v1

# Admin & System Email Management (Configurable via ENV, never hardcoded)
ADMIN_EMAIL=admin@aicareercompanion.com
SUPPORT_EMAIL=support@aicareercompanion.com
NOREPLY_EMAIL=noreply@aicareercompanion.com

# Authentication & Security
SECRET_KEY=development-secret-key-replace-in-production-min32chars
SESSION_COOKIE_NAME=aic_session
JWT_EXPIRATION=7d

# Database Connection (PostgreSQL Production / SQLite Dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_career_db

# Email SMTP Delivery (Optional in development, logs to console/admin outbox)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourwebsite.com
SMTP_PASS=your-smtp-password
